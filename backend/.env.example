# ---- How people sign in -------------------------------------------------
# "supabase": many people, each signs in with their email (the hosted product).
# "apikey":   one person, one secret key (running it just for yourself).
AUTH_MODE=supabase

# Only for AUTH_MODE=apikey. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# ---- Database (Supabase: Project settings > API) -------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # the secret service_role key. Never put this in the extension.

# Leave empty to use Supabase when the two values above are set.
# "memory" tries things locally with no database (data is lost on restart).
DB_DRIVER=

# Optional: on a server that stays on, "on" downloads Apple's list of privacy
# network addresses so Apple Mail preloads are labelled correctly.
APPLE_RANGES=

PORT=8787
