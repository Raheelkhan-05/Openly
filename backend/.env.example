# ---- How people sign in -------------------------------------------------
# "supabase": many people, each signs in with their email (the hosted product).
# "apikey":   one person, one secret key (running it just for yourself).
AUTH_MODE=supabase

# Only for AUTH_MODE=apikey. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# ---- Database (Supabase: Project settings > API) -------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # the secret service_role key. Never put this in the extension.

# Leave empty to use Supabase when the two values above are set.
# "memory" tries things locally with no database (data is lost on restart).
DB_DRIVER=

# Optional: on a server that stays on, "on" downloads Apple's list of privacy
# network addresses so Apple Mail preloads are labelled correctly.
APPLE_RANGES=

PORT=8787

# --- Speed (all optional) ---
# Redis for caching, shared by every server instance. Upstash's free tier is enough:
# create a Redis database at https://upstash.com and copy the REST URL and token (Vercel's Upstash integration sets KV_REST_API_* for you).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Only for an older Supabase project that signs tokens with a shared secret (Project Settings > API > JWT Secret).
# Newer projects publish public keys and need nothing here.
SUPABASE_JWT_SECRET=
# The tracking image answers first and saves the open afterwards. Set to "off" to save before answering.
DEFER_WRITES=on
